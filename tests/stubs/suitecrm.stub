        /** @var array<mixed> */
        public $_viewdefs;

        abstract public function handleSave(bool $populate = true): void;
    }

    class GridLayoutMetaDataParser extends AbstractMetaDataParser
    {
        public function handleSave(bool $populate = true): void
        {
        }
    }

    class ParserFactory
    {
        public static function getParser(string $view, string $moduleName, ?string $packageName = null, ?string $subpanelName = null): AbstractMetaDataParser
        {
        }
    }
}

